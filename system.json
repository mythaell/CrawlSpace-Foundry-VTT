{
  "id": "crawlspace",
  "title": "CrawlSpace",
  "description": "Rules, character sheets and combat automation for dungeon-crawling LitRPG play: health slots, ranked skills and spells, typed damage, debuffs, and five-phase Mob/Crawler combat.",
  "version": "0.9.6",
  "compatibility": {
    "minimum": "14",
    "verified": "14.370",
    "maximum": "14"
  },
  "authors": [{ "name": "Mythaell" }],
  "url": "https://github.com/mythaell/CrawlSpace-Foundry-VTT",
  "esmodules": ["dist/crawlspace.mjs"],
  "styles": ["styles/crawlspace.css"],
  "languages": [{ "lang": "en", "name": "English", "path": "lang/en.json" }],
  "documentTypes": {
    "Actor": {
      "crawler": { "htmlFields": ["biography", "notes"] },
      "mob": { "htmlFields": ["description", "notes"] },
      "minion": { "htmlFields": ["description", "notes"] },
      "companion": { "htmlFields": ["description", "notes", "companion.accessories"] },
      "npc": { "htmlFields": ["description", "notes"] }
    },
    "Item": {
      "skill": { "htmlFields": ["description"] },
      "spell": { "htmlFields": ["description"] },
      "weapon": { "htmlFields": ["description"] },
      "equipment": { "htmlFields": ["description"] },
      "consumable": { "htmlFields": ["description"] },
      "tattoo": { "htmlFields": ["description"] },
      "loot": { "htmlFields": ["description"] },
      "lootBox": { "htmlFields": ["description"] },
      "ability": { "htmlFields": ["description"] },
      "action": { "htmlFields": ["description"] },
      "race": { "htmlFields": ["description"] },
      "class": { "htmlFields": ["description"] },
      "background": { "htmlFields": ["description"] },
      "achievement": { "htmlFields": ["description"] },
      "trap": { "htmlFields": ["description"] }
    },
    "RegionBehavior": {
      "aura": {}
    }
  },
  "packs": [
    {
      "name": "homebrew-skills",
      "label": "Homebrew Skills",
      "path": "packs/homebrew-skills",
      "type": "Item",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "homebrew-spells",
      "label": "Homebrew Spells",
      "path": "packs/homebrew-spells",
      "type": "Item",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "actions",
      "label": "Actions",
      "path": "packs/actions",
      "type": "Item",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "interrupt-actions",
      "label": "Interrupt Actions",
      "path": "packs/interrupt-actions",
      "type": "Item",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "homebrew-items",
      "label": "Homebrew Items",
      "path": "packs/homebrew-items",
      "type": "Item",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    }
  ],
  "packFolders": [
    {
      "name": "CrawlSpace Rules",
      "color": "#1f5f8f",
      "packs": ["actions", "interrupt-actions"]
    },
    {
      "name": "CrawlSpace Homebrew",
      "color": "#7a2e1d",
      "packs": ["homebrew-skills", "homebrew-spells", "homebrew-items"]
    }
  ],
  "grid": { "distance": 5, "units": "ft" },
  "primaryTokenAttribute": "healthBar",
  "secondaryTokenAttribute": "mana",
  "socket": true,
  "initiative": "1d20",
  "manifest": "https://github.com/mythaell/CrawlSpace-Foundry-VTT/releases/latest/download/system.json",
  "download": "https://github.com/mythaell/CrawlSpace-Foundry-VTT/releases/download/v0.9.6/system.zip"
}
