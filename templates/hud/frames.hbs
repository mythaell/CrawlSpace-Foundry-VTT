<div class="crawl-frames-inner">
  {{#if frames.length}}
  <header class="crawl-frames-head" data-tooltip="{{localize 'CRAWLSPACE.Frames.DragHint'}}">
    <i class="fa-solid fa-grip-vertical"></i>
    <span>{{localize "CRAWLSPACE.Frames.Title"}}</span>
    <a data-action="toggle" data-tooltip="{{#if collapsed}}{{localize 'CRAWLSPACE.Frames.Show'}}{{else}}{{localize 'CRAWLSPACE.Frames.Hide'}}{{/if}}"><i class="fa-solid fa-chevron-{{#if collapsed}}down{{else}}up{{/if}}"></i></a>
  </header>
  {{/if}}
  {{#unless collapsed}}
  {{#each frames as |frame|}}
  <section class="crawl-frame" data-uuid="{{frame.uuid}}">
    <h3><a data-action="openSheet">{{frame.name}}</a>{{#if frame.players}} <small>({{frame.players}})</small>{{/if}}</h3>
    <div class="frame-health" data-pct="{{frame.pct}}" {{#if @root.gm}}data-health-track tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{frame.pct}}" data-tooltip="{{localize 'CRAWLSPACE.Frames.DragHealth'}}"{{else}}data-tooltip="{{localize 'CRAWLSPACE.Stat.Health'}}: {{frame.pct}}%"{{/if}} aria-label="{{frame.name}} {{localize 'CRAWLSPACE.Stat.Health'}}">
      <div class="fill" style="width: {{frame.pct}}%; background-color: {{frame.color}}"></div>
      <span>{{frame.pct}}%</span>
    </div>
    <div class="frame-mana" data-tooltip="{{localize 'CRAWLSPACE.Stat.Mana'}}: {{frame.mana.value}} / {{frame.mana.max}}">
      <div class="fill" style="width: {{frame.mana.pct}}%"></div>
    </div>
    {{#if frame.details}}
    <div class="frame-details">
      <span>{{localize "CRAWLSPACE.Stat.Evade"}} <b>{{frame.details.evade}}</b></span>
      <span>{{localize "CRAWLSPACE.Stat.DR"}} <b>{{frame.details.dr}}</b></span>
      <span>{{localize "CRAWLSPACE.Crawler.Level"}} <b>{{frame.details.level}}</b></span>
      <span>{{frame.details.race}}</span>
      <span>{{frame.details.className}}</span>
    </div>
    {{/if}}
    {{> crawlFrameBadges effects=frame.effects}}
    {{#each frame.followers as |follower|}}
    <div class="frame-follower" data-uuid="{{follower.uuid}}">
      <div class="follower-line"><a data-action="openSheet">{{follower.name}}</a> <small>{{follower.kind}}</small></div>
      <div class="frame-health small" data-tooltip="{{localize 'CRAWLSPACE.Stat.Health'}}: {{follower.health.value}}/{{follower.health.max}}">
        <div class="fill" style="width: {{follower.pct}}%; background-color: {{follower.color}}"></div>
        <span>{{follower.health.value}}/{{follower.health.max}}</span>
      </div>
      {{> crawlFrameBadges effects=follower.effects}}
    </div>
    {{/each}}
  </section>
  {{/each}}
  {{/unless}}
</div>

{{#*inline "crawlFrameBadges"}}
{{#if effects.length}}
<div class="frame-effects">
  {{#each effects as |effect|}}
  <button type="button" class="frame-effect {{effect.kind}}" data-effect-id="{{effect.id}}" data-tooltip="{{effect.tooltip}}<br><small>{{localize 'CRAWLSPACE.Frames.StackHint'}}</small>"><img src="{{effect.img}}" alt="{{effect.name}}">{{#if effect.stacks}}<b>{{effect.stacks}}</b>{{/if}}</button>
  {{/each}}
</div>
{{/if}}
{{/inline}}
