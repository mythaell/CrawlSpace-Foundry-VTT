{{!-- One ActiveEffect's changes as rule blocks. Context: effectId, rules, ruleTypes, editable. --}}
<div class="rules-list" data-rules-effect="{{effectId}}">
  {{#each rules as |rule|}}
  <section class="rule-block" data-rule-index="{{rule.index}}" data-rule-type="{{rule.id}}">
    <header class="rule-header">
      <i class="fa-solid fa-bars"></i>
      <h4>{{rule.label}}</h4>
      {{#if ../editable}}
      <a data-rule-action="json" data-tooltip="{{localize 'CRAWLSPACE.Rules.EditJsonHint'}}"><i class="fa-solid fa-code"></i></a>
      <a data-rule-action="delete" data-tooltip="{{localize 'CRAWLSPACE.Rules.Delete'}}"><i class="fa-solid fa-trash"></i></a>
      {{/if}}
    </header>
    <div class="rule-fields">
      {{#each rule.fields as |field|}}
      <label class="rule-field">
        <span>{{field.label}}</span>
        {{#if field.options}}
        <select data-rule-field="{{field.name}}">{{#each field.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        {{else if field.named}}
        <span class="rule-named">
          <input type="text" data-rule-field="{{field.name}}" value="{{field.value}}" list="{{field.named.list}}" data-named-types="{{field.named.types}}" placeholder="{{localize 'CRAWLSPACE.Rules.PickOrDrop'}}">
          {{#if field.named.uuid}}<a data-rule-open="{{field.named.uuid}}" data-tooltip="{{localize 'CRAWLSPACE.Rules.OpenLinked'}}"><i class="fa-solid fa-link"></i></a>{{/if}}
        </span>
        {{else if field.duration}}
        <span class="time-input"><input type="text" data-rule-field="{{field.name}}" value="{{field.value}}"><a class="time-picker" data-time-picker data-tooltip="{{localize 'CRAWLSPACE.Time.PickDuration'}}"><i class="fa-solid fa-clock"></i></a></span>
        {{else if field.damageTypes}}
        <span class="time-input"><input type="text" data-rule-field="{{field.name}}" value="{{field.value}}"><a class="time-picker" data-rule-damage-types data-tooltip="{{localize 'CRAWLSPACE.Rules.PickDamageTypes'}}"><i class="fa-solid fa-list-check"></i></a></span>
        {{else}}
        <input type="{{#if field.isNumber}}number{{else}}text{{/if}}" data-rule-field="{{field.name}}" value="{{field.value}}">
        {{/if}}
      </label>
      {{/each}}
    </div>
  </section>
  {{else}}
  <p class="rules-empty">{{localize "CRAWLSPACE.Rules.None"}}</p>
  {{/each}}
  {{#each datalists}}<datalist id="{{id}}">{{#each names}}<option value="{{this}}"></option>{{/each}}</datalist>{{/each}}
  {{#if editable}}
  <div class="rule-new">
    <select data-rule-new>{{#each ruleTypes}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
    <button type="button" data-rule-action="add"><i class="fa-solid fa-plus"></i> {{localize "CRAWLSPACE.Rules.New"}}</button>
  </div>
  {{/if}}
</div>
