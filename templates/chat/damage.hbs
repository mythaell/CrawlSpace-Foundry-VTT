<div class="crawl-card damage {{#if healing}}healing{{/if}}">
  <header class="card-head">
    {{#if img}}<img src="{{img}}" alt="">{{/if}}
    <div class="card-heading">
      <h4 class="card-title">{{#if healing}}<i class="fa-solid fa-heart"></i> {{/if}}{{label}}</h4>
      {{#if subtitle}}<span class="card-sub">{{subtitle}}</span>{{/if}}
    </div>
    {{#if tier}}<span class="roll-mode">{{tier}}</span>{{/if}}
  </header>
  {{#if tags.length}}<p class="damage-tags">{{#each tags}}<span class="tag">{{this}}</span>{{/each}}</p>{{/if}}
  {{#if details}}<div class="card-details">{{{details}}}</div>{{/if}}
</div>
