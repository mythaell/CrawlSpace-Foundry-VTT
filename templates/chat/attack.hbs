<div class="crawl-card attack">
  <header class="card-head">
    {{#if img}}<img src="{{img}}" alt="">{{/if}}
    <div class="card-heading">
      <h4 class="card-title">{{label}}</h4>
      {{#if subtitle}}<span class="card-sub">{{subtitle}}</span>{{/if}}
    </div>
    {{#if mode}}<span class="roll-mode">{{mode}}</span>{{/if}}
  </header>
  {{#if tags.length}}<p class="damage-tags">{{#each tags}}<span class="tag">{{this}}</span>{{/each}}</p>{{/if}}
</div>
