<section class="tab stats {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <h3>{{localize "CRAWLSPACE.Section.HealthBar"}}</h3>
  <div class="mob-slots">
    {{#each slots as |slot|}}
    <a class="mob-slot {{#if slot.filled}}filled{{/if}}" data-action="slotLost" data-index="{{slot.index}}"></a>
    {{/each}}
  </div>

  <h3>{{localize "CRAWLSPACE.Section.Stats"}}</h3>
  <table class="stats">
    <thead><tr><th></th><th>{{localize "CRAWLSPACE.Stat.Base"}}</th><th>{{localize "CRAWLSPACE.Stat.Total"}}</th><th>{{localize "CRAWLSPACE.Stat.Mod"}}</th></tr></thead>
    <tbody>
      {{#each stats as |stat|}}
      <tr>
        <th><a class="rollable" data-action="rollStat" data-stat="{{stat.key}}">{{stat.label}}</a></th>
        <td><input type="number" name="system.attributes.{{stat.key}}.value" value="{{crawlNumberOrBlank stat.source.value}}"></td>
        <td class="derived-value">{{crawlNumberOrBlank stat.total}}</td>
        <td class="derived-value mod"><a class="rollable" data-action="rollStat" data-stat="{{stat.key}}">{{crawlSigned stat.mod}}</a></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  <p class="hint">{{localize "CRAWLSPACE.Mob.StatPoints" value=system.statPoints}}</p>

  <div class="defense-grid">
    <label>{{localize "CRAWLSPACE.Stat.ArmorBase"}}<input type="number" name="system.dr.armor" value="{{systemSource.dr.armor}}"></label>
    <label>{{localize "CRAWLSPACE.Mob.PublishedEvade"}}<input type="text" name="system.evade.published" value="{{systemSource.evade.published}}" placeholder="10+DEX+F"></label>
    <label>{{localize "CRAWLSPACE.Stat.Move"}}<input type="number" name="system.move.value" value="{{systemSource.move.value}}"></label>
    <label>{{localize "CRAWLSPACE.Mob.Surprise"}}<input type="text" name="system.surprise" value="{{systemSource.surprise}}"></label>
    <label>{{localize "CRAWLSPACE.Mob.HealthSlots"}}<input type="number" name="system.healthSlotsOverride" value="{{crawlNumberOrBlank systemSource.healthSlotsOverride}}" placeholder="{{system.health.max}}"></label>
    <label>{{localize "CRAWLSPACE.Mob.HealthPerSlot"}}<input type="number" name="system.healthPerSlotOverride" value="{{crawlNumberOrBlank systemSource.healthPerSlotOverride}}" placeholder="{{system.health.perSlot}}"></label>
  </div>

  <div class="list-header">
    <span class="item-name">{{localize "CRAWLSPACE.Section.Attacks"}}</span>
    <span class="item-controls">{{#if editable}}<a data-action="addAttack"><i class="fa-solid fa-plus"></i></a>{{/if}}</span>
  </div>
  <ol class="mob-attacks">
    {{#each attacks as |attack|}}
    <li class="mob-attack" data-attack-index="{{attack.index}}">
      <div class="attack-line">
        <a class="rollable" data-action="mobAttack"><i class="fa-solid fa-dice-d20"></i></a>
        <input type="text" name="system.attacks.{{attack.index}}.name" value="{{attack.name}}" class="attack-name">
        <span class="to-hit" data-tooltip="{{localize 'CRAWLSPACE.Mob.ToHit'}}">{{localize "CRAWLSPACE.Mob.ToHitShort"}} {{attack.toHit}}</span>
        {{#if @root.editable}}<a data-action="deleteAttack"><i class="fa-solid fa-trash"></i></a>{{/if}}
      </div>
      <div class="attack-grid">
        <label>{{localize "CRAWLSPACE.Item.Stat"}}<input type="text" name="system.attacks.{{attack.index}}.stat" value="{{attack.stat}}"></label>
        <label>{{localize "CRAWLSPACE.Item.Damage"}}<input type="text" name="system.attacks.{{attack.index}}.damage" value="{{attack.damage}}"></label>
        <label>{{localize "CRAWLSPACE.Item.DamageTypes"}}<input type="text" name="system.attacks.{{attack.index}}.damageTypes" value="{{attack.types}}"></label>
        <label>{{localize "CRAWLSPACE.Item.Range"}}<input type="text" name="system.attacks.{{attack.index}}.range" value="{{attack.range}}"></label>
        <label>{{localize "CRAWLSPACE.Mob.PublishedToHit"}}<input type="text" name="system.attacks.{{attack.index}}.publishedToHit" value="{{attack.publishedToHit}}"></label>
        <label>{{localize "CRAWLSPACE.Mob.AoeType"}}<input type="text" name="system.attacks.{{attack.index}}.aoeType" value="{{attack.aoeType}}"></label>
        <label>{{localize "CRAWLSPACE.Mob.FailedDebuff"}}<input type="text" name="system.attacks.{{attack.index}}.failedDebuff" value="{{attack.failedDebuff}}"></label>
        <label class="check"><input type="checkbox" name="system.attacks.{{attack.index}}.ranged" {{checked attack.ranged}}> {{localize "CRAWLSPACE.Item.Ranged"}}</label>
        <label class="check"><input type="checkbox" name="system.attacks.{{attack.index}}.armorPiercing" {{checked attack.armorPiercing}}> {{localize "CRAWLSPACE.Item.ArmorPiercing"}}</label>
        <label class="check"><input type="checkbox" name="system.attacks.{{attack.index}}.magic" {{checked attack.magic}}> {{localize "CRAWLSPACE.Item.Magic"}}</label>
      </div>
      <input type="text" class="attack-notes" name="system.attacks.{{attack.index}}.notes" value="{{attack.notes}}" placeholder="{{localize 'CRAWLSPACE.Item.Notes'}}">
    </li>
    {{/each}}
  </ol>

  {{#if abilities.length}}
  <h3>{{localize "CRAWLSPACE.Mob.Abilities"}}</h3>
  <dl class="mob-abilities">
    {{#each abilities}}<dt>{{name}}</dt><dd>{{description}}</dd>{{/each}}
  </dl>
  {{/if}}

  {{#if items.length}}
  <div class="list-header"><span class="item-name">{{localize "CRAWLSPACE.Mob.Items"}}</span></div>
  <ol class="item-list">
    {{#each items as |item|}}{{> "systems/crawlspace/templates/actor/item-row.hbs" item=item}}{{/each}}
  </ol>
  {{/if}}
</section>
