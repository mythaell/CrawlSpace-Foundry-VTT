<section class="tab main {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <section class="crawl-table">
    <div class="table-head plain-head pf-bar">
      <span class="head-name">{{localize "CRAWLSPACE.Npc.StatBlock"}}</span>
      <span class="head-controls">{{#if (and statBlock editable)}}<a data-action="clearStatBlock" data-tooltip="{{localize 'CRAWLSPACE.Npc.ClearStatBlock'}}"><i class="fa-solid fa-link-slash"></i></a>{{/if}}</span>
    </div>
    {{#if statBlock}}
    <div class="npc-statblock">
      <a data-action="openStatBlock"><img src="{{statBlock.img}}" alt=""> {{statBlock.name}}</a>
      {{#if statBlock.system.evade}}<span class="pf-tags">
        <span class="pf-tag">{{localize "CRAWLSPACE.Stat.Evade"}} {{statBlock.system.evade.total}}</span>
        <span class="pf-tag">{{localize "CRAWLSPACE.Stat.DR"}} {{statBlock.system.dr.total}}</span>
        <span class="pf-tag">{{localize "CRAWLSPACE.Stat.Health"}} {{statBlock.system.health.value}}/{{statBlock.system.health.max}}</span>
      </span>{{/if}}
    </div>
    {{else}}
    <p class="hint npc-statblock">{{localize "CRAWLSPACE.Npc.DropMob"}}</p>
    {{/if}}
  </section>

  <section class="crawl-table">
    <div class="table-head plain-head pf-bar">
      <span class="head-name">{{localize "CRAWLSPACE.Mob.Items"}}</span>
      <span class="head-controls">{{#if editable}}<a data-action="createItem" data-type="loot"><i class="fa-solid fa-plus"></i></a>{{/if}}</span>
    </div>
    <ol class="table-rows">
      {{#each items as |item|}}{{> "systems/crawlspace/templates/actor/item-row.hbs" item=item mode="plain"}}{{else}}<li class="empty">—</li>{{/each}}
    </ol>
  </section>

  <h3 class="pf-section">{{localize "CRAWLSPACE.Item.Description"}}</h3>
  {{#if editable}}<prose-mirror name="system.description" value="{{systemSource.description}}" toggled>{{{enriched.description}}}</prose-mirror>{{else}}{{{enriched.description}}}{{/if}}
</section>
