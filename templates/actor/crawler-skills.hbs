<section class="tab skills {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{> "systems/crawlspace/templates/actor/filter-bar.hbs" table="skills" stats=filterStats checks=filterChecks categories=false}}
  <div class="crawl-table skill-table" data-filter-scope="skills">
    <div class="table-head">
      <span></span>
      <span>{{localize "CRAWLSPACE.Table.Name"}}</span>
      <span>{{localize "CRAWLSPACE.Table.Base"}}</span>
      <span>{{localize "CRAWLSPACE.Table.Enhanced"}}</span>
      <span>{{localize "CRAWLSPACE.Item.Stat"}}</span>
      <span>{{localize "CRAWLSPACE.Item.CheckType"}}</span>
      <span>{{localize "CRAWLSPACE.Item.Cooldown"}}</span>
      <span data-tooltip="{{localize 'CRAWLSPACE.Item.MarkHint'}}"><i class="fa-solid fa-check"></i></span>
      <span class="head-controls">
        {{#if editable}}
        <a data-action="createItem" data-type="skill" data-tooltip="{{localize 'CRAWLSPACE.Item.Create'}}"><i class="fa-solid fa-plus"></i></a>
        <a data-action="openPack" data-packs="{{packs}}" data-tooltip="{{localize 'CRAWLSPACE.Table.AddFromDatabase'}}"><i class="fa-solid fa-database"></i></a>
        {{/if}}
      </span>
    </div>
    <ol class="table-rows">
      {{#each skills as |item|}}{{> "systems/crawlspace/templates/actor/item-row.hbs" item=item mode="skill"}}{{else}}<li class="empty">{{localize "CRAWLSPACE.Empty.Skills"}}</li>{{/each}}
    </ol>
  </div>
</section>
