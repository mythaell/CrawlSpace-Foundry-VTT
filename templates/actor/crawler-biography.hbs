<section class="tab biography {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="bio-grid">
    <label><span>{{localize "CRAWLSPACE.Crawler.PersonalSpace"}}</span><input type="text" name="system.personalSpace.tier" value="{{systemSource.personalSpace.tier}}"></label>
  </div>
  <label class="flavor-field"><span>{{localize "CRAWLSPACE.Flavor.Label"}}</span><textarea name="system.flavor" rows="2" placeholder="{{localize 'CRAWLSPACE.Flavor.Placeholder'}}" {{#unless editable}}disabled{{/unless}}>{{systemSource.flavor}}</textarea><small class="hint">{{localize "CRAWLSPACE.Flavor.Hint"}}</small></label>
  <h3>{{localize "CRAWLSPACE.Crawler.Biography"}}</h3>
  {{#if editable}}<prose-mirror name="system.biography" value="{{systemSource.biography}}" toggled>{{{enriched.biography}}}</prose-mirror>{{else}}{{{enriched.biography}}}{{/if}}
  <h3>{{localize "CRAWLSPACE.Crawler.PastTrauma"}}</h3>
  {{#if editable}}<prose-mirror name="system.journal.pastTrauma" value="{{systemSource.journal.pastTrauma}}" toggled>{{{enriched.pastTrauma}}}</prose-mirror>{{else}}{{{enriched.pastTrauma}}}{{/if}}
  <h3>{{localize "CRAWLSPACE.Crawler.LooseEnds"}}</h3>
  {{#if editable}}<prose-mirror name="system.journal.looseEnds" value="{{systemSource.journal.looseEnds}}" toggled>{{{enriched.looseEnds}}}</prose-mirror>{{else}}{{{enriched.looseEnds}}}{{/if}}
  <h3>{{localize "CRAWLSPACE.Crawler.Regrets"}}</h3>
  {{#if editable}}<prose-mirror name="system.journal.regrets" value="{{systemSource.journal.regrets}}" toggled>{{{enriched.regrets}}}</prose-mirror>{{else}}{{{enriched.regrets}}}{{/if}}
  <h3>{{localize "CRAWLSPACE.Crawler.Notes"}}</h3>
  {{#if editable}}<prose-mirror name="system.notes" value="{{systemSource.notes}}" toggled>{{{enriched.notes}}}</prose-mirror>{{else}}{{{enriched.notes}}}{{/if}}
</section>
