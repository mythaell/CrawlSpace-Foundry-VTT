<aside class="crawl-sidebar">
  <img class="crawl-logo" src="systems/crawlspace/assets/crawlspace-logo.png" alt="CrawlSpace">

  <div class="mana-box" data-tooltip="{{localize 'CRAWLSPACE.Sheet.ManaHint'}}">
    <div class="mana-label">{{localize "CRAWLSPACE.Stat.Mana"}}</div>
    <div class="mana-fields">
      <input type="number" name="system.mana.value" value="{{systemSource.mana.value}}" min="0" aria-label="{{localize 'CRAWLSPACE.Sheet.CurrentMana'}}">
      <span class="mana-slash">/</span>
      <input type="text" value="{{system.mana.max}}" readonly tabindex="-1" aria-label="{{localize 'CRAWLSPACE.Sheet.MaxMana'}}">
    </div>
  </div>

  <div class="buff-button-row">
    <button type="button" class="shield-button" data-action="shieldPrompt">{{localize "CRAWLSPACE.Section.Shield"}}</button>
    <button type="button" data-action="openEffects">{{localize "CRAWLSPACE.Effect.Conditions"}}</button>
  </div>

  <div class="defense-row">
    <a class="defense-badge evade" data-action="rollStat" data-stat="evade" data-tooltip="{{evadeTooltip}}<br>{{localize 'CRAWLSPACE.Roll.EvadeHint'}}">
      <svg viewBox="0 0 40 44" aria-hidden="true"><path d="M20 2L37 12V31L20 42L3 31V12Z" fill="none" stroke="currentColor" stroke-width="2"/></svg>
      <b>{{system.evade.total}}</b>
      <span>{{localize "CRAWLSPACE.Stat.Evade"}}</span>
    </a>
    <div class="defense-badge dr" data-tooltip="{{drTooltip}}">
      <svg viewBox="0 0 40 44" aria-hidden="true"><path d="M20 2L36 8V22C36 32 28 38 20 42C12 38 4 32 4 22V8Z" fill="none" stroke="currentColor" stroke-width="2"/></svg>
      <b>{{system.dr.total}}</b>
      <span>{{localize "CRAWLSPACE.Stat.DR"}}</span>
    </div>
    <div class="defense-badge shield-dr {{#unless hasShield}}empty{{/unless}}" data-tooltip="{{localize 'CRAWLSPACE.Stat.ShieldDrHint'}}">
      <svg viewBox="0 0 40 44" aria-hidden="true"><path d="M20 2C26 6 32 7 37 7V20C37 31 29 38 20 42C11 38 3 31 3 20V7C8 7 14 6 20 2Z" fill="none" stroke="currentColor" stroke-width="2"/></svg>
      <b>{{#if hasShield}}{{system.shieldDr.value}}<small>/{{system.shieldDr.max}}</small>{{else}}—{{/if}}</b>
      <span>{{localize "CRAWLSPACE.Stat.ShieldDrShort"}}</span>
      {{#if (and hasShield @root.editable)}}
      <span class="shield-dr-buttons">
        <a data-action="shieldDr" data-delta="-1" data-tooltip="{{localize 'CRAWLSPACE.Stat.ShieldDrLose'}}"><i class="fa-solid fa-minus"></i></a>
        <a data-action="shieldDr" data-delta="1" data-tooltip="{{localize 'CRAWLSPACE.Stat.ShieldDrRestore'}}"><i class="fa-solid fa-plus"></i></a>
      </span>
      {{/if}}
    </div>
  </div>

  <div class="sidebar-responses">
    {{#each traitSections as |section|}}
    <section>
      <div class="response-section-header">
        <h3>{{section.label}}</h3>
        {{#if @root.editable}}<button type="button" data-action="editTraits" data-trait="{{section.key}}"><i class="fa-solid fa-pen"></i> {{localize "CRAWLSPACE.Sheet.Edit"}}</button>{{/if}}
      </div>
      {{#if section.values.length}}
      <div class="response-tags">{{#each section.values}}<span>{{this}}</span>{{/each}}</div>
      {{/if}}
    </section>
    {{/each}}
  </div>

  <label><span>{{localize "CRAWLSPACE.Crawler.AiFavor"}}</span><input type="number" name="system.details.aiFavor" value="{{systemSource.details.aiFavor}}"></label>
  <label><span>{{localize "CRAWLSPACE.Crawler.Popularity"}}</span><input type="number" name="system.details.popularity" value="{{systemSource.details.popularity}}"></label>
  <hr>
  <label><span>{{localize "CRAWLSPACE.Stat.Move"}}</span><input type="text" value="{{system.move.total}}" readonly tabindex="-1"></label>
  <label><span>{{localize "CRAWLSPACE.Stat.Step"}}</span><input type="text" value="{{system.step.total}}" readonly tabindex="-1"></label>
  <label data-tooltip="{{localize 'CRAWLSPACE.Stat.ActionsHint'}}"><span>{{localize "CRAWLSPACE.Stat.Actions"}}</span><input type="text" value="{{system.actions.total}}" readonly tabindex="-1"></label>
  {{#if editable}}<button type="button" class="upkeep-button" data-action="upkeep">{{localize "CRAWLSPACE.Upkeep.Button"}}</button>{{/if}}
</aside>
