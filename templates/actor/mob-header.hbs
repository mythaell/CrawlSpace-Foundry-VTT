<header class="pf-actor-header">
  <div class="pf-actor-title">
    <input class="pf-name" type="text" name="name" value="{{document.name}}">
    <div class="pf-level-badge">{{levelLabel}} <input type="number" name="system.level" value="{{systemSource.level}}" min="0" aria-label="{{localize 'CRAWLSPACE.Crawler.Level'}}"></div>
  </div>
  {{#if tagList.length}}<div class="pf-tags">{{#each tagList}}<span class="pf-tag">{{this}}</span>{{/each}}</div>{{/if}}
  <div class="pf-actor-fields">
    <label><span>{{localize "CRAWLSPACE.Mob.Kind"}}</span><select name="system.kind">{{selectOptions kindChoices selected=systemSource.kind localize=true}}</select></label>
    {{#if (eq systemSource.kind "boss")}}
    <label><span>{{localize "CRAWLSPACE.Mob.BossTier"}}</span><select name="system.bossTier">{{selectOptions bossTierChoices selected=systemSource.bossTier}}</select></label>
    {{/if}}
    <label><span>{{localize "CRAWLSPACE.Crawler.Floor"}}</span><input type="number" name="system.floor" value="{{systemSource.floor}}" min="0"></label>
    <label><span>{{localize "CRAWLSPACE.Crawler.Size"}}</span><input type="text" name="system.size" value="{{systemSource.size}}"></label>
    <label><span>{{localize "CRAWLSPACE.Mob.Type"}}</span><input type="text" name="system.type" value="{{systemSource.type}}"></label>
    <label class="wide"><span>{{localize "CRAWLSPACE.Mob.Tags"}}</span><input type="text" name="system.tags" value="{{systemSource.tags}}"></label>
  </div>
</header>
