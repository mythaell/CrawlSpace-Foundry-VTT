<header class="crawl-top">
  <div class="crawl-identity">
    <label class="name-field"><span>{{localize "CRAWLSPACE.Sheet.Name"}}</span><input type="text" name="name" value="{{document.name}}"></label>
    <label><span>{{localize "CRAWLSPACE.Crawler.Floor"}}</span><input type="number" name="system.details.floor" value="{{systemSource.details.floor}}" min="0"></label>
    <label>
      <span>{{localize "CRAWLSPACE.Crawler.Level"}}</span>
      <span class="level-up-field">
        <input type="number" name="system.details.level" value="{{systemSource.details.level}}" min="0" aria-label="{{localize 'CRAWLSPACE.Crawler.Level'}}">
        {{#if editable}}<button type="button" data-action="levelUp" data-tooltip="{{localize 'CRAWLSPACE.Upkeep.PointsWaiting' points=pendingStatPoints}}">{{localize "CRAWLSPACE.Upkeep.LevelUp"}}</button>{{/if}}
      </span>
    </label>
  </div>

  <div class="health-wrapper {{#if anyShield}}health-shield-wrapper{{/if}}">
    <div class="progress-track" aria-label="{{localize 'CRAWLSPACE.Stat.Health'}}">
      {{#each healthBoxes as |box|}}
      <div class="progress-box {{#unless box.filled}}health-pressed{{/unless}}" data-action="slot" data-percentage="{{box.percentage}}"
           data-tooltip="{{localize 'CRAWLSPACE.Health.SlotTooltip' pct=box.percentage threshold=box.threshold}}">
        <input type="text" value="{{box.threshold}}" readonly tabindex="-1" aria-label="{{box.percentage}}%">
        <span>{{box.percentage}}%</span>
      </div>
      {{/each}}
    </div>
    {{#if anyShield}}
    <div class="progress-track shield-track" aria-label="{{localize 'CRAWLSPACE.Section.Shield'}}">
      {{#each shieldBoxes as |box|}}
      <div class="progress-box" data-action="shield" data-index="{{box.index}}" data-tooltip="{{localize 'CRAWLSPACE.Sheet.ShieldSlotHint'}}">
        <input type="text" value="{{@root.system.shield.value}}" readonly tabindex="-1">
      </div>
      {{/each}}
      {{#each conditionShieldBoxes as |box|}}
      <div class="progress-box condition-shield" data-tooltip="{{box.tooltip}}">
        <input type="text" value="{{box.perSlot}}" readonly tabindex="-1">
      </div>
      {{/each}}
    </div>
    {{/if}}
  </div>
  {{#if system.isDying}}<p class="dying-tag">{{localize "CRAWLSPACE.Health.Dying"}}{{#if (ne system.health.dyingCountdown null)}} ({{system.health.dyingCountdown}}){{/if}}</p>{{/if}}
  <div class="mana-bar-track" data-tooltip="{{localize 'CRAWLSPACE.Stat.Mana'}}: {{system.mana.value}} / {{system.mana.max}}">
    <div class="mana-bar-fill" style="width: {{system.mana.pct}}%"></div>
  </div>
</header>
