<section class="tab main {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="main-grid">
    <div class="stats-block">
      <h3>{{localize "CRAWLSPACE.Section.Stats"}}</h3>
      <table class="stats">
        <thead><tr><th></th><th>{{localize "CRAWLSPACE.Stat.Base"}}</th><th>{{localize "CRAWLSPACE.Stat.Total"}}</th><th>{{localize "CRAWLSPACE.Stat.Mod"}}</th><th>{{localize "CRAWLSPACE.Stat.Override"}}</th></tr></thead>
        <tbody>
          {{#each stats as |stat|}}
          <tr>
            <th><a class="rollable" data-action="rollStat" data-stat="{{stat.key}}" data-tooltip="{{localize 'CRAWLSPACE.Roll.StatHint'}}">{{stat.label}}</a></th>
            <td><input type="number" name="system.attributes.{{stat.key}}.value" value="{{crawlNumberOrBlank stat.source.value}}"></td>
            <td class="derived-value" {{#if stat.bonus}}data-tooltip="{{localize 'CRAWLSPACE.Stat.FromEffects'}}: {{crawlSigned stat.bonus}}"{{/if}}>{{crawlNumberOrBlank stat.total}}</td>
            <td class="derived-value mod"><a class="rollable" data-action="rollStat" data-stat="{{stat.key}}">{{crawlSigned stat.mod}}</a></td>
            <td class="overrides">
              <input type="number" name="system.attributes.{{stat.key}}.override" value="{{crawlNumberOrBlank stat.source.override}}" placeholder="—" data-tooltip="{{localize 'CRAWLSPACE.Stat.OverrideTotal'}}">
              <input type="number" name="system.attributes.{{stat.key}}.modOverride" value="{{crawlNumberOrBlank stat.source.modOverride}}" placeholder="—" data-tooltip="{{localize 'CRAWLSPACE.Stat.OverrideMod'}}">
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>

      <h3>{{localize "CRAWLSPACE.Section.Defenses"}}</h3>
      <div class="defense-grid">
        <label>{{localize "CRAWLSPACE.Stat.ArmorBase"}}<input type="number" name="system.dr.armor" value="{{systemSource.dr.armor}}"></label>
        <label>{{localize "CRAWLSPACE.Stat.DrBuffs"}}<input type="number" name="system.dr.buff" value="{{systemSource.dr.buff}}"></label>
        <label>{{localize "CRAWLSPACE.Stat.DrOverride"}}<input type="number" name="system.dr.override" value="{{crawlNumberOrBlank systemSource.dr.override}}" placeholder="{{system.dr.total}}"></label>
        <label>{{localize "CRAWLSPACE.Stat.EvadeBuffs"}}<input type="number" name="system.evade.buff" value="{{systemSource.evade.buff}}"></label>
        <label>{{localize "CRAWLSPACE.Stat.EvadeOverride"}}<input type="number" name="system.evade.override" value="{{crawlNumberOrBlank systemSource.evade.override}}" placeholder="{{system.evade.total}}"></label>
        <label>{{localize "CRAWLSPACE.Stat.ManaOverride"}}<input type="number" name="system.mana.override" value="{{crawlNumberOrBlank systemSource.mana.override}}" placeholder="{{system.mana.max}}"></label>
      </div>
      {{#if (or system.traits.resistances.size system.traits.vulnerabilities.size system.traits.immunities.size)}}
      <p class="traits">
        {{#if system.traits.resistances.size}}<span><b>{{localize "CRAWLSPACE.Trait.Resist"}}:</b> {{crawlJoin system.traits.resistances}}</span>{{/if}}
        {{#if system.traits.vulnerabilities.size}}<span><b>{{localize "CRAWLSPACE.Trait.Vulnerable"}}:</b> {{crawlJoin system.traits.vulnerabilities}}</span>{{/if}}
        {{#if system.traits.immunities.size}}<span><b>{{localize "CRAWLSPACE.Trait.Immune"}}:</b> {{crawlJoin system.traits.immunities}}</span>{{/if}}
      </p>
      {{/if}}
    </div>

    <div class="health-block">
      <h3>{{localize "CRAWLSPACE.Section.HealthBar"}} {{#if system.isDying}}<span class="dying-tag">{{localize "CRAWLSPACE.Health.Dying"}}{{#if (ne system.health.dyingCountdown null)}} ({{system.health.dyingCountdown}}){{/if}}</span>{{/if}}</h3>
      <ol class="health-slots">
        {{#each healthSlots as |slot|}}
        <li class="slot {{#if slot.filled}}filled{{/if}}" data-action="slot" data-percentage="{{slot.percentage}}"
            data-tooltip="{{localize 'CRAWLSPACE.Health.SlotTooltip' pct=slot.percentage threshold=slot.threshold}}">
          <span class="pct">{{slot.percentage}}%</span><span class="threshold">{{slot.threshold}}</span>
        </li>
        {{/each}}
      </ol>
      <p class="hint">{{localize "CRAWLSPACE.Health.Hint"}}</p>

      <h3>{{localize "CRAWLSPACE.Section.Shield"}} <small>({{localize "CRAWLSPACE.Health.ShieldValue" value=system.shield.value}})</small></h3>
      <div class="shield-slots">
        {{#each shieldSlots as |slot|}}
        <a class="shield {{#if slot.on}}on{{/if}}" data-action="shield" data-index="{{slot.index}}"><i class="fa-solid fa-shield-halved"></i></a>
        {{/each}}
        {{#if editable}}
        <a class="shield-control" data-action="shield" data-mode="add" data-tooltip="{{localize 'CRAWLSPACE.Health.AddShield'}}"><i class="fa-solid fa-plus"></i></a>
        {{#if shieldSlots.length}}<a class="shield-control" data-action="shield" data-mode="clear" data-tooltip="{{localize 'CRAWLSPACE.Health.ClearShield'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
        {{/if}}
      </div>
    </div>
  </div>

  <h3>{{localize "CRAWLSPACE.Section.Attacks"}}</h3>
  <ol class="item-list attacks">
    {{#each attacks as |item|}}{{> "systems/crawlspace/templates/actor/item-row.hbs" item=item mode="attack"}}{{/each}}
    <li class="item-row unarmed"><a class="item-name rollable" data-action="attackUnarmed"><i class="fa-solid fa-hand-fist"></i> {{localize "CRAWLSPACE.Attack.Unarmed"}}</a></li>
  </ol>

  <h3>{{localize "CRAWLSPACE.Section.Hotlist"}} <small>({{hotlist.length}}/{{system.hotlist.capacity}})</small></h3>
  <ol class="item-list hotlist" data-hotlist>
    {{#each hotlist as |item|}}{{> "systems/crawlspace/templates/actor/item-row.hbs" item=item mode="hotlist"}}{{else}}<li class="empty">{{localize "CRAWLSPACE.Hotlist.Empty"}}</li>{{/each}}
  </ol>
</section>
