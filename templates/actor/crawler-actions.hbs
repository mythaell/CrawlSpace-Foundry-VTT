<section class="tab actions {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{!-- Active native cooldown effects; deleting one resets it. --}}
  {{#if cooldowns.length}}
  <section class="crawl-table">
    <div class="table-head plain-head"><span>{{localize "CRAWLSPACE.Time.Cooldowns"}}</span></div>
    <ol class="table-rows">
      {{#each cooldowns}}<li class="effect-row" data-effect-id="{{id}}"><span class="item-name">{{name}}</span><span data-cooldown-id="{{id}}">{{remaining}}</span>{{#if @root.editable}}<button type="button" data-action="deleteEffect">{{localize "CRAWLSPACE.Time.Reset"}}</button>{{/if}}</li>{{/each}}
    </ol>
  </section>
  {{/if}}

  <section class="crawl-table hotlist-table" data-hotlist>
    <div class="table-head plain-head">
      <span class="head-name">{{localize "CRAWLSPACE.Section.Hotlist"}} <small>({{hotlist.length}}/{{system.hotlist.capacity}})</small></span>
      <span class="head-controls">{{#if editable}}<a data-action="configureHotlist" data-tooltip="{{localize 'CRAWLSPACE.Hotlist.ConfigureHint'}}"><i class="fa-solid fa-gear"></i> {{localize "CRAWLSPACE.Hotlist.Configure"}}</a>{{/if}}</span>
    </div>
    <ol class="table-rows">
      {{#each hotlist as |item|}}{{> "systems/crawlspace/templates/actor/item-row.hbs" item=item mode="hotlist"}}{{else}}<li class="empty">{{localize "CRAWLSPACE.Hotlist.Empty"}}</li>{{/each}}
    </ol>
  </section>

  <section class="crawl-table attack-table" data-attack-drop>
    <div class="table-head plain-head">
      <span class="head-name">{{localize "CRAWLSPACE.Section.Attacks"}}</span>
      <span class="head-controls">{{#if editable}}<a data-action="addAttack" data-tooltip="{{localize 'CRAWLSPACE.Attack.Add'}}"><i class="fa-solid fa-plus"></i> {{localize "CRAWLSPACE.Attack.Add"}}</a>{{/if}}</span>
    </div>
    <ol class="table-rows">
      {{#each attacks as |attack|}}
      <li class="pf-strike draggable {{#if attack.expanded}}expanded{{/if}}" data-attack-id="{{attack.id}}" data-expand-key="{{attack.expandKey}}">
        <div class="strike-main">
          <img class="row-img" src="{{attack.img}}" alt="" data-action="attackRoll" data-tooltip="{{localize 'CRAWLSPACE.Attack.Roll'}}">
          <div class="strike-body">
            <div class="strike-title">
              <a class="row-name" data-action="toggleExpand">{{attack.name}}</a>
              {{#if attack.tags.length}}<span class="pf-tags">{{#each attack.tags}}<span class="pf-tag">{{this}}</span>{{/each}}</span>{{/if}}
            </div>
            <div class="strike-buttons">
              <button type="button" class="strike-attack" data-action="attackRoll" data-tooltip="{{attack.modifiers}}">{{localize "CRAWLSPACE.Attack.Attack"}} {{attack.toHit}}</button>
              <button type="button" data-action="attackDamage" data-tier="normal" data-tooltip="{{attack.types}}"><i class="fa-solid fa-burst"></i> {{#if attack.damage}}{{attack.damage}}{{else}}{{localize "CRAWLSPACE.Attack.Damage"}}{{/if}}</button>
              <button type="button" data-action="attackDamage" data-tier="critical"><i class="fa-solid fa-star"></i> {{localize "CRAWLSPACE.Attack.Critical"}}</button>
            </div>
          </div>
          <span class="row-controls">
            <a data-action="attackToChat" data-tooltip="{{localize 'CRAWLSPACE.Item.ToChat'}}"><i class="fa-solid fa-comment"></i></a>
            {{#if @root.editable}}
            <a data-action="editAttack" data-tooltip="{{localize 'CRAWLSPACE.Attack.Edit'}}"><i class="fa-solid fa-pen-to-square"></i></a>
            {{#if attack.saved}}<a data-action="deleteAttack" data-tooltip="{{localize 'CRAWLSPACE.Attack.Delete'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
            {{/if}}
          </span>
        </div>
        <div class="row-details"><div class="row-description">{{{attack.notes}}}</div></div>
      </li>
      {{/each}}
    </ol>
  </section>

  {{#each actionGroups as |group|}}
  <section class="crawl-table action-table" data-action-drop="{{group.kind}}">
    <div class="table-head plain-head">
      <span class="head-name">{{group.label}}</span>
      <span class="head-controls">{{#if @root.editable}}<a data-action="configureActions" data-tooltip="{{localize 'CRAWLSPACE.Actions.ConfigureHint'}}"><i class="fa-solid fa-gear"></i> {{localize "CRAWLSPACE.Hotlist.Configure"}}</a>
        <a data-action="browseActions" data-kind="{{group.kind}}" data-tooltip="{{localize 'CRAWLSPACE.Actions.Browse'}}"><i class="fa-solid fa-magnifying-glass"></i></a>
        <a data-action="addAction" data-kind="{{group.kind}}" data-tooltip="{{localize 'CRAWLSPACE.Actions.Add'}}"><i class="fa-solid fa-plus"></i> {{localize "CRAWLSPACE.Actions.Add"}}</a>{{/if}}</span>
    </div>
    <ol class="table-rows">
      {{#each group.rows as |action|}}
      <li class="crawl-row draggable {{#if action.expanded}}expanded{{/if}}" data-action-row="{{action.id}}" {{#unless action.auto}}data-action-index="{{action.index}}"{{/unless}} data-expand-key="{{action.expandKey}}">
        <div class="row-main">
          <img class="row-img" src="{{action.img}}" alt="" data-action="useAction" data-tooltip="{{localize 'CRAWLSPACE.Item.Use'}}">
          <a class="row-name" data-action="toggleExpand">{{action.name}}{{#if action.sourceName}} <small>({{action.sourceName}})</small>{{/if}}{{#if action.auto}} <small class="row-auto">{{localize "CRAWLSPACE.Actions.FromHotlist"}}</small>{{/if}}</a>
          <span class="col">{{action.formula}}</span>
          <span class="row-controls">
            <a data-action="actionToChat" data-tooltip="{{localize 'CRAWLSPACE.Item.ToChat'}}"><i class="fa-solid fa-comment"></i></a>
 {{#if (and @root.editable (not action.auto))}}
            <a data-action="editAction" data-tooltip="{{localize 'CRAWLSPACE.Item.Edit'}}"><i class="fa-solid fa-pen-to-square"></i></a>
            <a data-action="deleteAction" data-tooltip="{{localize 'CRAWLSPACE.Item.Delete'}}"><i class="fa-solid fa-trash"></i></a>
            {{/if}}
          </span>
        </div>
        <div class="row-details"><div class="row-description">{{{action.notesHtml}}}</div></div>
      </li>
      {{else}}<li class="empty">—</li>{{/each}}
    </ol>
  </section>
  {{/each}}
</section>
