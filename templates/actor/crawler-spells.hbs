<section class="tab spells {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="list-header">
    <span class="item-name">{{localize "TYPES.Item.spell"}}</span>
    <span class="col rank">{{localize "CRAWLSPACE.Item.Rank"}}</span>
    <span class="col mana">{{localize "CRAWLSPACE.Stat.Mana"}}</span>
    <span class="col bonus">{{localize "CRAWLSPACE.Item.Check"}}</span>
    <span class="col mark"><i class="fa-solid fa-check"></i></span>
    <span class="item-controls">{{#if editable}}<a data-action="createItem" data-type="spell" data-tooltip="{{localize 'CRAWLSPACE.Item.Create'}}"><i class="fa-solid fa-plus"></i></a>{{/if}}</span>
  </div>
  <ol class="item-list">
    {{#each spells as |item|}}{{> "systems/crawlspace/templates/actor/item-row.hbs" item=item}}{{else}}<li class="empty">{{localize "CRAWLSPACE.Empty.Spells"}}</li>{{/each}}
  </ol>
</section>
