<section class="tab abilities {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{#each featureSections as |section|}}
  <section class="feature-section" data-feature-section="{{section.key}}">
    <header class="feature-head">
      <h3>{{section.label}}</h3>
      {{#if @root.editable}}
      <span class="feature-head-controls">
        {{#if section.browse}}<button type="button" class="feature-browse" data-action="openBuildPack" data-kind="{{section.browse.kind}}" data-tooltip="{{localize 'CRAWLSPACE.Build.Browse'}}"><i class="fa-solid fa-magnifying-glass"></i> {{localize "CRAWLSPACE.Feature.Browse"}}</button>{{/if}}
        {{#if section.packs}}<button type="button" class="feature-browse" data-action="openPack" data-packs="{{section.packs}}" data-tooltip="{{localize 'CRAWLSPACE.Table.AddFromDatabase'}}"><i class="fa-solid fa-magnifying-glass"></i> {{localize "CRAWLSPACE.Feature.Browse"}}</button>{{/if}}
        <button type="button" class="feature-browse" data-action="createItem" data-type="{{section.create.type}}" {{#if section.create.category}}data-category="{{section.create.category}}"{{/if}} data-tooltip="{{localize 'CRAWLSPACE.Item.Create'}}"><i class="fa-solid fa-plus"></i></button>
      </span>
      {{/if}}
    </header>
    <ol class="feature-list">
      {{#each section.rows as |item|}}{{> "systems/crawlspace/templates/actor/feature-row.hbs" item=item}}{{else}}<li class="feature-empty">—</li>{{/each}}
    </ol>
  </section>
  {{/each}}
</section>
