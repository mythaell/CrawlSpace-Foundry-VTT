{{!-- The paper doll: a framed slot for each body part and hand (paper-doll.ts). Drop gear on a slot to equip it there. --}}
<section class="crawl-paper-doll">
  <div class="doll-stage">
    <svg class="doll-art" viewBox="{{doll.viewBox}}" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <defs>
        <pattern id="doll-grid-{{document.id}}" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M20 0H0V20" fill="none" stroke="#8cfff6" stroke-opacity="0.07" stroke-width="1"/>
        </pattern>
      </defs>
      <path class="doll-frame-fill" d="{{doll.frame}}"/>
      <path d="{{doll.frame}}" fill="url(#doll-grid-{{document.id}})"/>
      <path class="doll-frame-edge" d="{{doll.frame}}"/>
    </svg>
    {{#each doll.slots as |slot|}}
    <div class="doll-slot {{#if slot.item}}filled{{/if}} {{#if slot.item.broken}}broken{{/if}} {{#if slot.twoHandedEcho}}echo{{/if}}" style="{{slot.style}}"
         data-doll-slot="{{slot.slot}}" data-doll-hand="{{slot.hand}}" {{#if slot.item}}data-item-id="{{slot.item.id}}" data-tooltip-html="{{slot.item.tooltip}}" data-tooltip-direction="UP"{{else}}data-tooltip="{{slot.label}}"{{/if}}>
      {{#if slot.item}}
      <img src="{{slot.item.img}}" alt="{{slot.item.name}}" data-action="editItem">
      {{#if (and @root.editable (not slot.twoHandedEcho))}}<a class="doll-unequip" data-action="toggleEquip" data-tooltip="{{localize 'CRAWLSPACE.Item.Unequip'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      {{else}}
      <i class="fa-solid {{slot.icon}} doll-placeholder"></i>
      {{/if}}
      <span class="doll-label">{{slot.label}}</span>
    </div>
    {{/each}}
  </div>
  <div class="doll-accessories" data-doll-slot="accessory">
    <span class="doll-acc-title">{{localize "CRAWLSPACE.Doll.accessories"}} <small>{{doll.accessoryCount}}/{{doll.accessoryLimit}}</small></span>
    <div class="doll-acc-row">
      {{#each doll.accessories as |item|}}
      <div class="doll-slot filled {{#if item.broken}}broken{{/if}}" data-doll-slot="accessory" data-item-id="{{item.id}}" data-tooltip-html="{{item.tooltip}}" data-tooltip-direction="UP">
        <img src="{{item.img}}" alt="{{item.name}}" data-action="editItem">
        {{#if @root.editable}}<a class="doll-unequip" data-action="toggleEquip" data-tooltip="{{localize 'CRAWLSPACE.Item.Unequip'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      </div>
      {{/each}}
      {{#if doll.canAddAccessory}}<div class="doll-slot empty-accessory" data-doll-slot="accessory" data-tooltip="{{localize 'CRAWLSPACE.Doll.accessoryHint'}}"><i class="fa-solid fa-ring doll-placeholder"></i></div>{{/if}}
    </div>
  </div>
</section>
