<aside class="pf-side">
  <img class="pf-side-portrait" src="{{document.img}}" alt="{{document.name}}" data-action="editImage" data-edit="img" data-tooltip="{{localize 'CRAWLSPACE.Sheet.PortraitHint'}}">

  {{#each traitSections as |section|}}
  {{#if section.values.length}}
  <div class="pf-side-block"><h4>{{section.label}}</h4><div class="pf-tags">{{#each section.values}}<span class="pf-tag">{{this}}</span>{{/each}}</div></div>
  {{/if}}
  {{/each}}

  <div class="pf-side-block">
    <h4>{{localize "CRAWLSPACE.Section.Stats"}}</h4>
    <div class="pf-side-stats">
      {{#each stats as |stat|}}
      <div class="pf-side-attr">
        <a class="rollable" data-action="rollStat" data-stat="{{stat.key}}">{{stat.code}}</a>
        <input type="number" name="system.attributes.{{stat.key}}.value" value="{{crawlNumberOrBlank stat.source.value}}" aria-label="{{stat.label}}">
        <a class="rollable mod" data-action="rollStat" data-stat="{{stat.key}}">{{crawlSigned stat.mod}}</a>
      </div>
      {{/each}}
    </div>
  </div>
</aside>
