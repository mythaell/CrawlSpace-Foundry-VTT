<div class="crawl-dialog roll-check">
  {{#if difficulty}}<p class="hint">DC {{difficulty}}</p>{{/if}}
  {{#if floorDifficulty}}<label><input type="checkbox" name="floorCheck"> {{localize "CRAWLSPACE.Roll.FloorCheck" dc=floorDifficulty}}</label>{{/if}}
  <ul class="modifiers">
    {{#each modifiers}}
    <li><label><input type="checkbox" name="mod-{{index}}" {{checked enabled}}> {{label}} {{#if detail}}<small class="hint">{{detail}}</small>{{else}}<b>{{crawlSigned value}}</b>{{/if}}</label></li>
    {{/each}}
  </ul>
  <div class="form-group">
    <label>{{localize "CRAWLSPACE.Roll.Extra"}}</label>
    <div class="form-fields">
      <input type="number" name="extra" value="0">
      <input type="text" name="extraLabel" placeholder="{{localize 'CRAWLSPACE.Roll.Temporary'}}">
    </div>
  </div>
  <div class="form-group">
    <label>{{localize "CRAWLSPACE.Roll.ModeLabel"}}</label>
    <div class="form-fields">
      <select name="mode">
        <option value="normal" {{#if (eq mode "normal")}}selected{{/if}}>{{localize "CRAWLSPACE.Roll.Mode.normal"}}</option>
        <option value="advantage" {{#if (eq mode "advantage")}}selected{{/if}}>{{localize "CRAWLSPACE.Roll.Mode.advantage"}}</option>
        <option value="disadvantage" {{#if (eq mode "disadvantage")}}selected{{/if}}>{{localize "CRAWLSPACE.Roll.Mode.disadvantage"}}</option>
      </select>
    </div>
  </div>
</div>
