<section class="tab effects {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="list-header">
    <span class="item-name">{{localize "CRAWLSPACE.Effect.ItemEffects"}}</span>
    <span class="item-controls">{{#if editable}}<a data-action="createEffect" data-tooltip="{{localize 'CRAWLSPACE.Effect.Create'}}"><i class="fa-solid fa-plus"></i></a>{{/if}}</span>
  </div>
  <ol class="item-list">
    {{#each effects as |effect|}}
    <li class="effect-row draggable {{#if effect.disabled}}disabled{{/if}}" data-effect-id="{{effect.id}}">
      <img class="item-img" src="{{effect.img}}" alt="">
      <div class="item-name">
        <a data-action="editEffect">{{effect.name}}</a>
        {{#if effect.requiredRank}}<span class="tag">{{localize "CRAWLSPACE.Effect.AtRank" rank=effect.requiredRank}}</span>{{/if}}
        {{#unless effect.transfer}}<span class="tag" data-tooltip="{{localize 'CRAWLSPACE.Effect.ApplyHint'}}">{{localize "CRAWLSPACE.Effect.OnTarget"}}</span>{{/unless}}
        <ul class="changes">{{#each effect.changes}}<li><code>{{this}}</code></li>{{/each}}</ul>
      </div>
      <span class="item-controls">
        <a data-action="toggleEffect"><i class="fa-solid {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i></a>
        <a data-action="editEffect"><i class="fa-solid fa-pen-to-square"></i></a>
        {{#if @root.editable}}<a data-action="deleteEffect"><i class="fa-solid fa-trash"></i></a>{{/if}}
      </span>
    </li>
    {{else}}<li class="empty">{{localize "CRAWLSPACE.Empty.ItemEffects"}}</li>{{/each}}
  </ol>
  <p class="hint">{{localize "CRAWLSPACE.Effect.ItemHint"}}</p>
</section>
