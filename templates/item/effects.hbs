<section class="tab rules {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <h3 class="pf-section">{{localize "CRAWLSPACE.Ids.Title"}}</h3>
  {{> "systems/crawlspace/templates/sheets/ids.hbs" ids=ids}}
  <h3 class="pf-section">{{localize "CRAWLSPACE.Effect.Title"}}</h3>
  {{#each effects as |effect|}}
  <section class="effect-block {{#if effect.disabled}}effect-off{{/if}}" data-effect-id="{{effect.id}}">
    <header class="effect-block-header">
      <img src="{{effect.img}}" alt="">
      <a class="effect-name" data-action="editEffect" data-tooltip="{{localize 'CRAWLSPACE.Effect.Edit'}}">{{effect.name}}</a>
      {{#if effect.requiredRank}}<span class="pf-tag">{{localize "CRAWLSPACE.Effect.AtRank" rank=effect.requiredRank}}</span>{{/if}}
      <a class="pf-tag {{#unless effect.transfer}}on-target{{/unless}}" {{#if @root.editable}}data-action="toggleTransfer"{{/if}} data-tooltip="{{localize 'CRAWLSPACE.Effect.ApplyHint'}}">
        {{#if effect.transfer}}{{localize (ifThen (eq @root.item.type "spell") "CRAWLSPACE.Effect.OnCast" "CRAWLSPACE.Effect.OnSelf")}}{{else}}{{localize "CRAWLSPACE.Effect.OnTarget"}}{{/if}}
      </a>
      <span class="controls">
        <a data-action="toggleEffect" data-tooltip="{{localize (ifThen effect.disabled 'CRAWLSPACE.Effect.Enable' 'CRAWLSPACE.Effect.Disable')}}"><i class="fa-solid {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i></a>
        <a data-action="editEffect" data-tooltip="{{localize 'CRAWLSPACE.Effect.Edit'}}"><i class="fa-solid fa-pen-to-square"></i></a>
        {{#if @root.editable}}<a data-action="deleteEffect" data-tooltip="{{localize 'CRAWLSPACE.Effect.Delete'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
      </span>
    </header>
    {{> "systems/crawlspace/templates/effects/rules.hbs" effectId=effect.id rules=effect.rules ruleTypes=@root.ruleTypes editable=@root.editable}}
  </section>
  {{else}}
  <p class="rules-empty">{{localize "CRAWLSPACE.Empty.ItemEffects"}}</p>
  {{/each}}
  {{#each datalists}}<datalist id="{{id}}">{{#each names}}<option value="{{this}}"></option>{{/each}}</datalist>{{/each}}
  {{#if editable}}<button type="button" class="pf-add" data-action="createEffect"><i class="fa-solid fa-plus"></i> {{localize "CRAWLSPACE.Effect.Create"}}</button>{{/if}}
  <p class="hint">{{localize "CRAWLSPACE.Effect.ItemHint"}}</p>
</section>
