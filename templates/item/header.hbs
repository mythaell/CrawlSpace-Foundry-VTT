<header class="pf-header">
  <img class="pf-portrait" src="{{item.img}}" alt="{{item.name}}" data-action="editImage" data-edit="img">
  <div class="pf-title">
    <input class="pf-name" type="text" name="name" value="{{item.name}}">
    {{#if tags.length}}<div class="pf-tags">{{#each tags}}<span class="pf-tag">{{this}}</span>{{/each}}</div>{{/if}}
  </div>
  <div class="pf-type">{{typeLabel}}</div>
</header>
