<section class="tab description {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{#if editable}}
  <prose-mirror name="system.description" value="{{systemSource.description}}" toggled>{{{enrichedDescription}}}</prose-mirror>
  {{else}}
  <div class="description">{{{enrichedDescription}}}</div>
  {{/if}}
</section>
