{
  "name": "crawlspace-foundry-vtt",
  "private": true,
  "version": "0.9.6",
  "description": "CrawlSpace game system for Foundry Virtual Tabletop V14",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "packs:homebrew": "node tools/build-homebrew-packs.mjs",
    "packs:content": "node tools/build-content-module.mjs",
    "packs:actions": "node tools/build-action-packs.mjs",
    "packs": "npm run packs:homebrew && npm run packs:actions && npm run packs:content",
    "link": "node tools/link-foundry.mjs",
    "release": "node tools/package-release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mythaell/CrawlSpace-Foundry-VTT.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.5",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "allowScripts": {
    "classic-level@3.0.0": true,
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
